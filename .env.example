# uv runtime in restricted sandboxes
UV_CACHE_DIR=/tmp/uv-cache
UV_PYTHON_INSTALL_DIR=/tmp/uv-python

# Minimal Agent World live configuration.
# Do not commit real API keys.
OPENAI_API_KEY=
JINA_API_KEY=

# Default non-secret settings live in config/agent-world.default.yaml.
# Override the config file only when you intentionally want another profile set.
# AGENT_WORLD_CONFIG=config/agent-world.default.yaml
# OPENAI_BASE_URL=https://provider.example.test/v1
