{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-world.candidate-manifest.schema.json",
  "title": "Agent World Candidate Manifest",
  "type": "object",
  "required": ["candidate_dir", "environment_id", "implementation_id", "contract_ref", "generated_files", "self_check"],
  "properties": {
    "candidate_dir": {"const": "generated"},
    "environment_id": {"type": "string", "minLength": 1},
    "implementation_id": {"type": "string", "minLength": 1},
    "contract_ref": {"const": "contract.json"},
    "generated_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "source_refs"],
        "properties": {
          "path": {"type": "string"},
          "kind": {
            "enum": ["contract", "source", "state", "adapter", "script", "spec", "manifest", "check_report", "lockfile", "config", "test", "documentation", "other"]
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "self_check": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {"type": "array", "items": {"type": "string"}},
        "report_ref": {"type": "string"}
      }
    },
    "replay_commands": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
  }
}
