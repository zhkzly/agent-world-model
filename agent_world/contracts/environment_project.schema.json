{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-world.environment-project.schema.json",
  "title": "Agent World Generated Environment Project",
  "type": "object",
  "required": [
    "schema_version",
    "environment_id",
    "runtime_abi_version",
    "interfaces",
    "tools",
    "state",
    "trace"
  ],
  "properties": {
    "schema_version": {"const": "agent-world.environment-project.v1"},
    "environment_id": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "implementation_id": {"type": "string"},
    "runtime_abi_version": {"const": "agent-world.runtime-abi.v1"},
    "interfaces": {
      "type": "object",
      "required": ["describe", "setup", "reset", "health", "invoke", "verify", "export_trace", "teardown"],
      "additionalProperties": false
    },
    "tools": {"type": "array", "items": {"type": "object"}},
    "state": {"type": "object"},
    "trace": {"type": "object"},
    "surfaces": {"type": "array", "items": {"type": "object"}},
    "tasks_ref": {"type": "string"},
    "verifiers_ref": {"type": "string"}
  }
}
